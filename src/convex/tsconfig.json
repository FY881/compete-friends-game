{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,

    /* 🛡 فحص تراكمي (Incremental) — ضروري للاستقرار في هذه البيئة:
       فحص Convex لهذا المشروع (57 ألف سطر، 152 وحدة) يستهلك ~650MB من
       الذاكرة. بيئة التشغيل محدودة بـ 2GB، فأقدم نفاد ذاكرة يقتل عملية
       tsc فتظهر الرسالة المضللة «TypeScript typecheck timed out».

       مع الفحص التراكمي: التشغيل الأول يبني الحالة كاملة، ثم كل تشغيل
       تالٍ يفحص المتغيّر فقط — من ٢٥ ثانية/650MB إلى ~٥ ثوانٍ/أقل بكثير،
       مع الحفاظ على كامل قائمة الملفات التي يقرأها Convex (--listFiles).

       ملف الحالة في node_modules/.tmp (نفس مسار حالة التطبيق) فلا
       يُلوّث الكود ولا يُرفع للمستودع. */
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.convex.tsbuildinfo"
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
