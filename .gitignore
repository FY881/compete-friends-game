.env.local
node_modules
dist
src/convex/_generated

# 🧹 منع تضخّم التخزين مجدداً (السبب الجذري لامتلاء قرص الـ VM)
# «isolate/» كانت نسخة كاملة مكررة من public/ تُخزَّن داخل المشروع بلا فائدة.
isolate/
# ملفات APK الميتة داخل الكود — لا يستوردها أي ملف؛ الإصدارات تُستضاف خارجياً.
src/assets/*.apk
# كاشات بناء وسيطة
.vite
.turbo
.cache

# Native Android project is generated fresh by the CI workflow (cap add android)
android

# 💥 كرّات انهيار النواة (core dumps) — إعداد النواة هنا core_pattern=core،
# فانهيار واحد كتب ملفاً بحجم 1.1 جيجا في جذر المشروع وأوقف البيئة. احذفها ولا ترفعها.
core
core.*
*.core
# مجلد الحماية core/ نفسه مقصود ولا يجب تجاهله
!core/
